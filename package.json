{
  "name": "notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ds:check": "node scripts/ds/ds-check.mjs",
    "experience:discover": "node scripts/experience/discover.mjs",
    "experience:validate": "node scripts/experience/validate.mjs",
    "experience:self-test": "node scripts/experience/self-test.mjs",
    "experience:capture": "node scripts/experience/capture.mjs",
    "experience:audit": "node scripts/experience/audit.mjs --enforce",
    "experience:report": "node scripts/experience/audit.mjs",
    "test:accessibility": "node scripts/experience/audit.mjs --enforce",
    "test:fixtures": "node --import tsx --test src/server/demo/fixtures.test.ts",
    "test:design-lab:model": "node --import tsx --test src/app/__design-lab/notes/lab-model.test.ts src/app/__design-lab/notes/lab-access.test.ts",
    "check:design-lab-boundary": "node scripts/design-lab/privacy-boundary.mjs",
    "test:design-lab-boundary": "node --import tsx --test scripts/design-lab/privacy-boundary.test.mjs",
    "test:design-lab": "pnpm run test:design-lab:model && pnpm run check:design-lab-boundary && pnpm run test:design-lab-boundary",
    "test:design-lab:e2e": "playwright test --config playwright.design-lab.config.ts",
    "design-lab:capture-evidence": "node scripts/design-lab/capture-evidence.mjs",
    "design-lab:measure-performance": "node scripts/design-lab/measure-performance.mjs",
    "test": "node scripts/check-suite-switcher-contract.mjs && node scripts/check-chrome-contract.mjs && node scripts/check-loading-contract.mjs && node scripts/check-suiteloader-identity.mjs && node scripts/check-calendar-cron-auth-contract.mjs && node --test src/server/cross-tenant-isolation.test.mjs && node --import tsx --test src/lib/access-mode.test.ts src/lib/sentry-scrub.test.ts src/lib/timeline-promotion.test.ts src/server/account-erasure.test.ts src/server/account-export.test.ts src/server/cross-product-assertion.test.ts src/server/tasks-personalization.test.ts && pnpm run test:design-lab",
    "check:suite-switcher": "node scripts/check-suite-switcher-contract.mjs",
    "check:loading": "node scripts/check-loading-contract.mjs",
    "check:calendar-cron-auth": "node scripts/check-calendar-cron-auth-contract.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.3",
    "@libsql/client": "^0.17.3",
    "@sentry/nextjs": "^10.58.0",
    "drizzle-orm": "^0.45.2",
    "motion": "^12.38.0",
    "next": "16.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
