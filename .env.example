# ─── Signal Studio access mode ──────────────────────────────────────────────
# Controls how the app is accessed. One of: production | development | demo | review
#   production  — real Clerk auth required, real user data, normal security
#   development — local dev; keyless Clerk bypass + dev fallback identity
#   demo        — public, no login wall, synthetic demo user + in-memory seed
#   review      — same as demo, for design / Claude Code / Fable review cycles
# Server reads SIGNAL_ACCESS_MODE; the browser reads NEXT_PUBLIC_SIGNAL_ACCESS_MODE.
# Set BOTH to the same value on a demo/review deployment.
SIGNAL_ACCESS_MODE=production
NEXT_PUBLIC_SIGNAL_ACCESS_MODE=production

# Optional override for the development banner copy.
# NEXT_PUBLIC_DEV_BANNER_TEXT="In development — expected launch September 1st."

# First-capture signature moment fires once, ever, on a new notebook's first
# note. Set to "off" to disable entirely.
# NEXT_PUBLIC_NOTES_FIRST_CAPTURE=off

# ─── Clerk (production auth) ─────────────────────────────────────────────────
# Not required in demo/review mode. Required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Sister-product URLs (cross-product nav) ─────────────────────────────────
# NEXT_PUBLIC_STUDIO_URL=https://signalstudio.ie
# NEXT_PUBLIC_TASKS_URL=https://tasks.signalstudio.ie
# NEXT_PUBLIC_TIMELINE_URL=https://timeline.signalstudio.ie
# NEXT_PUBLIC_SIGNAL_URL=https://signal.signalstudio.ie
# NEXT_PUBLIC_NOTES_URL=https://notes.signalstudio.ie

# ─── Sentry (error tracking) ─────────────────────────────────────────────────
# All optional. When DSN is unset the SDK no-ops — the app boots without Sentry.
# Server-side ingest (instrumentation.ts):
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Browser ingest (instrumentation-client.ts) — must be NEXT_PUBLIC_*:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
