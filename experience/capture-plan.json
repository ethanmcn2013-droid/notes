{
  "schemaVersion": "signal-experience-capture-plan/1",
  "determinism": {
    "locale": "en-GB",
    "timezoneId": "Europe/London",
    "colorScheme": "light",
    "reducedMotion": "reduce",
    "fixedTime": "2026-07-15T09:00:00.000Z",
    "settleMilliseconds": 350
  },
  "consolidationScope": {
    "status": "legacy-service-repository",
    "productOwnerRepository": "ethanmcn2013-droid/tasks",
    "canonicalAppRoute": "https://app.signalstudio.ie/app/notes",
    "canonicalMarketingRoute": "https://signalstudio.ie/notes",
    "retainedLocalRoutes": [
      "/app/account",
      "/api/*",
      "/sign-in",
      "/sign-up"
    ],
    "capturePolicy": "Capture only routes still rendered by this service. Retired marketing and Notes product routes are redirect contracts and are verified by the consolidated route contract instead of following production cross-origin destinations from CI."
  },
  "breakpoints": [
    "compactMobile",
    "mobile",
    "tablet",
    "desktop",
    "wide"
  ],
  "captures": [
    {
      "experienceId": "notes.page.app-account",
      "state": "default",
      "path": "/app/account",
      "expectedContent": "Your Signal account"
    },
    {
      "experienceId": "notes.state.root-not-found",
      "state": "error",
      "path": "/experience-quality-missing",
      "expectedContent": "This page faded.",
      "expectedStatus": 404,
      "expectedRuntimeErrors": true
    }
  ]
}
